    {
      "cell_type": "markdown",
      "source": [
        "##7.Convert precipitation units"
      ],
      "metadata": {
        "id": "f2Iru84NUwDT"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "precip_mm = precip.copy()\n",
        "precip_mm.attrs[\"units\"] = \"mm\"\n",
        "precip_mm.attrs[\"long_name\"] = \"Accumulated precipitation\""
      ],
      "metadata": {
        "id": "9GAVyAg9UyRN"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "##8.Subset CONUS"
      ],
      "metadata": {
        "id": "gp1P6uo-VGDU"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "precip_mm = precip_mm.assign_coords(\n",
        "    longitude=((precip_mm.longitude + 180) % 360) - 180\n",
        ").sortby(\"longitude\")"
      ],
      "metadata": {
        "id": "hftUQIC9VJ1g"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "if precip_mm.latitude[0] > precip_mm.latitude[-1]:\n",
        "    precip_us = precip_mm.sel(\n",
        "        longitude=slice(-125, -66),\n",
        "        latitude=slice(50, 24)\n",
        "    )\n",
        "else:\n",
        "    precip_us = precip_mm.sel(\n",
        "        longitude=slice(-125, -66),\n",
        "        latitude=slice(24, 50)\n",
        "    )\n",
        "\n",
        "precip_us"
      ],
