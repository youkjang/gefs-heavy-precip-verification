      "cell_type": "markdown",
      "source": [
        "###2.Import Libraries"
      ],
      "metadata": {
        "id": "Ht_E4u6Q--Nr"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import xarray as xr\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import s3fs\n",
        "from pathlib import Path"
      ],
      "metadata": {
        "id": "9uDFoVmv4Vqn"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import cartopy.crs as ccrs"
      ],
      "metadata": {
        "id": "I7BsAzJdWbGO"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "###3.Set GEFS case information"
      ],
      "metadata": {
        "id": "bC34tzvM_K4A"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "init_date = \"20260520\"   # YYYYMMDD\n",
        "cycle = \"00\"             # 00, 06, 12, 18 UTC\n",
        "member = \"c00\"           # control member\n",
        "fhr = 24                 # forecast hour\n",
        "\n",
        "cache_dir = Path(\"/content/gefs_precip_cache\")\n",
        "cache_dir.mkdir(exist_ok=True)\n",
        "\n",
        "fs = s3fs.S3FileSystem(anon=True)"
      ],
      "metadata": {
        "id": "ww43pCtgJdVh"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "##4.Download one GEFS precipitataion file from Amazon S3"
      ],
      "metadata": {
        "id": "WKbhwEipQ045"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "fname = f\"ge{member}.t{cycle}z.pgrb2a.0p50.f{fhr:03d}\"\n",
        "\n",
        "s3_key = (\n",
        "    f\"noaa-gefs-pds/gefs.{init_date}/{cycle}/atmos/pgrb2ap5/\"\n",
        "    f\"{fname}\"\n",
        ")\n",
        "\n",
        "local_file = cache_dir / fname\n",
        "\n",
        "print(\"S3 path:\")\n",
        "print(s3_key)\n",
        "\n",
        "if not local_file.exists():\n",
        "    print(f\"Downloading {fname}\")\n",
        "    fs.get(s3_key, str(local_file))\n",
        "else:\n",
        "    print(f\"Using cached file: {fname}\")\n",
        "\n",
        "local_file"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "13_9X02lQ5A0",
        "outputId": "95feff46-3c47-43dd-ba6a-c15334179a9a"
      },
